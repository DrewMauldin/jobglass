<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jobglass.fixture.backup</string>
  <key>ProgramArguments</key>
  <array><string>/usr/bin/rsync</string><string>--archive</string><string>/Users/fixture/Documents</string></array>
  <key>StartInterval</key><integer>3600</integer>
  <key>WatchPaths</key><array><string>/Users/fixture/Documents</string></array>
  <key>WorkingDirectory</key><string>/Users/fixture</string>
